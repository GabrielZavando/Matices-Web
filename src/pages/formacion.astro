---
import Layout from '../layouts/Layout.astro'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import { Image } from 'astro:assets'
import CompanyLogos from '../components/global/CompanyLogos.astro'
import Reveal from '../components/ui/Reveal.astro'
import EvidenceGallery from '../components/ui/EvidenceGallery.astro'

// Optimized image imports
import formacion from '../assets/formacion.jpeg'

interface FormationPartner {
  title: string
  icon: string
  iconBg: string
  iconColor: string
  description: string
}

const formationPartners: FormationPartner[] = [
  {
    title: 'Alianzas y Representación Internacional',
    icon: 'M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9',
    iconBg: 'bg-azul-celeste/10',
    iconColor: 'text-azul-celeste',
    description:
      'Contamos con una sólida red global de soporte exclusivo y representaciones institucionales que respaldan la validez, innovación y vanguardia de nuestros contenidos y metodologías de capacitación a nivel internacional.',
  },
  {
    title: 'Cursos y Programas Personalizados',
    icon: 'M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4',
    iconBg: 'bg-verde-lima/20',
    iconColor: 'text-verde-bosque',
    description:
      'Diseñamos programas de entrenamiento a la medida de tu empresa. Realizamos un levantamiento minucioso de necesidades formativas (DNC) para estructurar itinerarios pedagógicos alineados exactamente con tus desafíos organizacionales.',
  },
]
---

<Layout
  title="Formación y Capacitación Continua"
  description="Matices Consultoría - Programas de formación corporativa, desarrollo de competencias B2B, aula virtual y capacitación personalizada a la medida."
>
  <Header activePath="/formacion" />

  <main class="w-full bg-crema-calido/20">
    <!-- Hero Section -->
    <section
      class="relative w-full overflow-hidden pt-12 pb-24 md:pt-20 md:pb-32 bg-radial from-verde-lima/5 to-transparent"
    >
      <div class="absolute -top-10 -right-10 h-48 w-48 rounded-full bg-verde-lima/10 blur-3xl -z-10 pointer-events-none animate-float"></div>
      <div
        class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Hero Copy -->
        <div class="lg:col-span-7 space-y-6 z-10 text-left">
          <Reveal as="span" variant="fade-up" delay={0} class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Capacitación &amp; Crecimiento Corporativo
          </Reveal>
          <Reveal as="h1" variant="fade-up" delay={80} class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-verde-bosque leading-tight">
            Formación y <span class="text-verde-lima font-normal italic"
              >Capacitación Continua</span
            >
          </Reveal>
          <Reveal as="p" variant="fade-up" delay={160} class="font-sans text-lg text-verde-bosque/80 max-w-xl leading-relaxed">
            Potenciamos las competencias técnicas y relacionales de tus equipos
            mediante talleres prácticos y programas formativos a la medida,
            diseñados para asegurar un impacto real, medible y sostenible.
          </Reveal>
          <Reveal as="div" variant="fade-up" delay={240} class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href="/contacto"
              class="bg-verde-bosque hover:bg-verde-bosque/90 text-white font-sans text-center font-semibold py-4 px-8 rounded-xl hover:-translate-y-0.5 hover:shadow-lg active:scale-95 transition-all text-sm block"
            >
              Consulta por nuestros progarmas
            </a>
          </Reveal>
        </div>

        <!-- Graphic Content -->
        <Reveal as="div" variant="scale-in" delay={120} class="lg:col-span-5 relative w-full flex justify-center">
          <div
            class="w-full max-w-md aspect-[4/5] rounded-[3rem] overflow-hidden shadow-2xl relative border-4 border-white/40"
          >
            <Image
              src={formacion}
              alt="Colaboradores en una dinámica grupal de capacitación corporativa"
              width={640}
              height={800}
              format="avif"
              loading="eager"
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
              class="w-full h-full object-cover"
            />
          </div>
          <Reveal as="div" variant="fade-up" delay={320} class="absolute -bottom-6 -right-6 bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-xl border border-verde-bosque/10 max-w-[200px] hidden sm:block animate-float">
            <p class="font-heading text-xl font-bold text-verde-bosque mb-1">
              +150
            </p>
            <p class="text-sm font-semibold text-verde-bosque/70 leading-tight">
              Talleres y workshops corporativos ejecutados a nivel nacional.
            </p>
          </Reveal>
        </Reveal>
      </div>
    </section>

    <!-- Section Superior de Formación & Aula Virtual -->
    <section id="programas" class="w-full py-20 bg-white border-t border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Cabecera Informativa -->
        <Reveal as="div" variant="fade-up" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5 space-y-4">
            <span class="inline-block px-4 py-1.5 rounded-full bg-azul-celeste/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
              Programas de Formación Continua
            </span>
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque leading-tight">
              Fortalecimiento de Competencias junto a <span class="text-verde-lima font-normal italic">Profesionales de Trayectoria</span>
            </h2>
          </div>
          <div class="lg:col-span-7 lg:pt-8">
            <p class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed">
              Diseñamos e impartimos experiencias de aprendizaje de alto impacto técnico y relacional. Trabajamos de la mano con un selecto cuerpo profesionales senior con amplia trayectoria práctica y académica, garantizando que cada programa entregue herramientas de aplicación que impulsen la productividad, el liderazgo y el desarrollo del talento en tu organización.
            </p>
          </div>
        </Reveal>

        <!-- Subbloque Aula Virtual / Calendario -->
        <Reveal as="div" variant="fade-up" class="bg-crema-calido/50 p-8 md:p-12 rounded-[2.5rem] border border-verde-bosque/5 hover:border-verde-bosque/10 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-8 space-y-4">
              <span class="inline-block px-3 py-1 rounded-full bg-verde-lima/20 text-verde-bosque font-sans text-xs font-bold uppercase tracking-wider">
                Exclusivo para Chile y Latinoamérica
              </span>
              <h3 class="font-heading text-2xl md:text-3xl font-bold text-verde-bosque">
                Conoce nuestra aula virtual
              </h3>
              <p class="font-sans text-sm md:text-base text-verde-bosque/75 max-w-2xl leading-relaxed">
                Nuestra plataforma LMS interactiva te permite acceder a una experiencia formativa completamente flexible y multidispositivo. Si ya eres parte de la comunidad de capacitación, puedes ingresar usando el botón.
              </p>
            </div>

            <div class="lg:col-span-4 flex justify-start lg:justify-end w-full">
              <a 
                href="https://lightgoldenrodyellow-elk-265097.hostingersite.com/login/index.php" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full sm:w-auto bg-verde-bosque hover:bg-verde-bosque/90 text-white font-sans font-bold py-4 px-8 rounded-xl shadow-lg transition-all hover:-translate-y-0.5 hover:shadow-xl active:scale-95 text-center text-sm inline-block uppercase tracking-wider"
              >
                INGRESAR A AULA VIRTUAL
              </a>
            </div>

          </div>
        </Reveal>

      </div>
    </section>

    <!-- Banner de Dolor / Empatía (Intermedio) -->
    <section class="w-full py-20 bg-[#2e3131] text-crema-calido relative overflow-hidden shadow-xl">
      <div class="absolute top-0 right-0 w-96 h-96 bg-verde-lima/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-azul-celeste/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
      
      <Reveal as="div" variant="fade-up" class="max-w-[1280px] mx-auto px-4 md:px-16 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-6">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 text-crema-calido font-sans text-xs font-semibold uppercase tracking-widest">
            Formación Organizacional Estratégica
          </span>
          <h2 class="font-heading text-3xl md:text-5xl font-bold leading-tight">
            ¿Tus equipos de trabajo están listos para los desafíos del mañana?
          </h2>
          <p class="font-sans text-base md:text-lg text-crema-calido/80 max-w-3xl leading-relaxed">
            Las brechas de competencias limitan el crecimiento de las empresas B2B. Diseñamos consultoría en formación organizacional enfocada en resolver problemas reales, alineando los objetivos de negocio de tu compañía con el desarrollo profesional de tus colaboradores. Hablemos y llevemos a tu organización al siguiente nivel.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 justify-start lg:justify-end w-full">
          <a 
            href="/contacto" 
            class="bg-verde-lima hover:bg-verde-lima/90 text-verde-bosque font-sans font-bold py-4 px-10 rounded-full hover:scale-105 transition-all shadow-lg text-center w-full block uppercase tracking-wider"
          >
            HABLEMOS AHORA
          </a>
          <a 
            href="/contacto"
            class="border border-crema-calido/35 text-crema-calido hover:bg-white/5 font-sans font-semibold py-4 px-10 rounded-full transition-all text-center w-full block text-sm"
          >
            Solicita el Brochure de Cursos
          </a>
        </div>
      </Reveal>
    </section>

    <!-- Sección Intermedia de Alianzas y Cursos -->
    <section class="w-full py-20 bg-crema-calido/30 border-b border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Dos subbloques en grid responsivo -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          {formationPartners.map((partner, i) => (
            <Reveal as="article" variant="fade-up" delay={i * 80} class="bg-white p-8 md:p-12 rounded-[2.5rem] shadow-md border border-verde-bosque/5 flex flex-col justify-between hover:shadow-xl transition-shadow duration-300 min-h-[350px]">
              <div class="space-y-6">
                <div class={`w-12 h-12 rounded-2xl flex items-center justify-center ${partner.iconBg} ${partner.iconColor}`}>
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={partner.icon} />
                  </svg>
                </div>
                <div class="space-y-3">
                  <h3 class="font-heading text-2xl md:text-3xl font-bold text-verde-bosque">
                    {partner.title}
                  </h3>
                  <p class="font-sans text-sm md:text-base text-verde-bosque/75 leading-relaxed">
                    {partner.description}
                  </p>
                </div>
              </div>
            </Reveal>
          ))}
        </div>

        <!-- Botón de llamado a la acción comercial -->
        <Reveal as="div" variant="fade-up" class="flex justify-center pt-4">
          <a 
            href="/contacto" 
            class="bg-verde-bosque hover:bg-verde-bosque/90 text-white font-sans font-bold py-4 px-12 rounded-full hover:-translate-y-0.5 hover:shadow-xl active:scale-95 transition-all text-center text-sm uppercase tracking-wider"
          >
            SOLICITAR PROPUESTA
          </a>
        </Reveal>

      </div>
    </section>

    <!-- Componente Reutilizable: Clientes / Prueba Social -->
    <CompanyLogos />

    <!-- Componente Reutilizable: Galería de Evidencia / Actividad -->
    <section class="w-full py-20 bg-crema-calido/20">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-12">
        <Reveal as="div" variant="fade-up" class="text-center space-y-3">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Actividad &amp; Ejecución Práctica
          </span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque">
            Galería de Evidencia
          </h2>
          <p class="font-sans text-base text-verde-bosque/75">
            Registros reales de la ejecución práctica de nuestros programas de formación, workshops interactivos y actividades dinámicas de aprendizaje.
          </p>
        </Reveal>

        <EvidenceGallery />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
