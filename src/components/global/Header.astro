---
import { Image } from 'astro:assets'
import logoImage from '../../assets/logo.webp'

interface Props {
  activePath?: string;
}

const { activePath = "" } = Astro.props;

const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Testing', href: '/testing' },
  { name: 'I+D', href: '/id' },
  { name: 'Formación', href: '/formacion' },
  { name: 'Talento', href: '/talento' },
  { name: 'Psicología', href: '/psicologia' }
]
---

<header class="w-full sticky top-0 z-50 bg-crema-calido/80 backdrop-blur-md border-b border-verde-bosque/10 transition-colors duration-300">
  <nav class="flex justify-between items-center px-4 md:px-16 py-4 max-w-[1280px] mx-auto relative">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <Image
        src={logoImage}
        alt="Logo Matices"
        class="h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Hamburger Button (Mobile Only) -->
    <button 
      id="menu-toggle-btn" 
      class="cursor-pointer md:hidden flex flex-col justify-between w-6 h-4.5 z-40 focus:outline-none" 
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="w-full h-[2px] bg-verde-bosque rounded transition-all duration-300"></span>
      <span class="w-full h-[2px] bg-verde-bosque rounded transition-all duration-300"></span>
      <span class="w-full h-[2px] bg-verde-bosque rounded transition-all duration-300"></span>
    </button>

    <!-- Overlay de Fondo para el Drawer (Móvil) -->
    <div 
      id="drawer-overlay" 
      class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
    ></div>

    <!-- Navigation Menu (Drawer Panel) -->
    <div 
      id="drawer-panel" 
      class="fixed md:static top-0 right-0 h-[100dvh] md:h-auto w-[80vw] md:w-auto max-w-[400px] md:max-w-none bg-crema-calido md:bg-transparent border-l border-verde-bosque/10 md:border-none shadow-2xl md:shadow-none flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-8 py-16 md:py-0 px-6 md:px-0 z-50 transform translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out"
    >
      <!-- Botón de Cierre Dedicado (Móvil) -->
      <button 
        id="drawer-close-btn" 
        class="absolute top-4 right-4 md:hidden text-verde-bosque hover:opacity-80 p-2 focus:outline-none"
        aria-label="Cerrar menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Navigation Links -->
      <div class="flex flex-col md:flex-row gap-6 md:gap-8 w-full md:w-auto mt-8 md:mt-0">
        {navItems.map((item) => {
          const isActive = activePath === item.href;
          return (
            <a
              href={item.href}
              class={`font-sans text-lg md:text-base transition-colors relative py-3 md:py-1 hover:text-verde-bosque w-full md:w-auto text-left border-b border-verde-bosque/5 md:border-none block ${
                isActive 
                  ? "text-verde-bosque font-semibold border-b-2 border-verde-bosque/20 md:border-verde-bosque" 
                  : "text-verde-bosque/80 hover:text-verde-bosque"
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </div>
      
      <!-- Sticky CTA Button -->
      <a 
        href="/contacto" 
        class="mt-6 md:mt-0 bg-verde-bosque text-white px-6 py-2.5 rounded-full font-sans font-semibold hover:opacity-90 active:scale-95 transition-all text-center w-full md:w-auto block"
      >
        Solicitar Asesoría
      </a>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const closeBtn = document.getElementById('drawer-close-btn');
  const panel = document.getElementById('drawer-panel');
  const overlay = document.getElementById('drawer-overlay');
  const body = document.body;

  function openMenu() {
    if (panel && overlay && toggleBtn && body) {
      panel.classList.remove('translate-x-full');
      panel.classList.add('translate-x-0');

      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');

      body.classList.add('overflow-hidden');
      toggleBtn.setAttribute('aria-expanded', 'true');
    }
  }

  function closeMenu() {
    if (panel && overlay && toggleBtn && body) {
      panel.classList.add('translate-x-full');
      panel.classList.remove('translate-x-0');

      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');

      body.classList.remove('overflow-hidden');
      toggleBtn.setAttribute('aria-expanded', 'false');
    }
  }

  if (toggleBtn && closeBtn && panel && overlay) {
    toggleBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);

    // Salvaguarda para cuando se redimensiona a escritorio para evitar dejar el scroll bloqueado
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });
  }
</script>
