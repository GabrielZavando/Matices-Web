---
/**
 * ScouthemShowcase — presentational section promoting the Scouthem platform
 * (TICKET-005, change `add-scouthem-section`, task T-002).
 *
 * Layer: dumb. Pure markup: no state, no <script>. Copy is literal from the
 * approved mock `docs/assets/design/nueva-seccion.jpeg` (REQ-004/SC-005).
 * Layout is mobile-first (docs/frontend-standards.md §2): single column with
 * the text block first, scaling to two columns at lg: with the visual panel
 * on the left (REQ-005/SC-006).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Reveal from './Reveal.astro';

interface Props {
  /** Extra classes appended to the root <section> (presentational only). */
  class?: string;
}

const { class: extraClasses = '' } = Astro.props;

/**
 * Visual panel slot (REQ-006/REQ-007): the dashboard artwork is resolved
 * eagerly from `src/assets/scouthem-section.*`. When the designer asset is
 * missing the glob matches nothing, so the panel renders empty but still
 * reserves its space and the build stays green (SC-007).
 */
const dashboardAssets = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/scouthem-section.*',
  { eager: true },
);
const dashboardImage = Object.values(dashboardAssets)[0]?.default;

/**
 * Responsive srcset widths for the panel image (REQ-007/SC-008): derived
 * from the natural metadata so they never upscale past the source.
 */
const dashboardSrcsetWidths = dashboardImage
  ? [Math.round(dashboardImage.width / 2), dashboardImage.width]
  : [];

/** External destination agreed for the single home CTA (REQ-003). */
const SCOUTHEM_HREF = 'https://scouthem.com/es/pagina-de-inicio/';
---

<section class:list={['w-full py-20 md:py-24 bg-crema-calido/20', extraClasses]}>
  <div
    class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center"
  >
    <!-- Text block: first in the DOM (mobile renders it above the panel);
         right column at lg: via order. -->
    <div class="space-y-6 text-left lg:order-2">
      <Reveal
        as="span"
        variant="fade-up"
        delay={0}
        class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase"
      >
        PLATAFORMA DE RECLUTAMIENTO Y SELECCIÓN
      </Reveal>

      <Reveal as="div" variant="fade-up" delay={80}>
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-verde-bosque leading-tight">
          Revoluciona tu <span class="text-verde-lima font-normal italic">Selección de Talento</span>
        </h2>
      </Reveal>

      <Reveal
        as="p"
        variant="fade-up"
        delay={160}
        class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed max-w-xl"
      >
        Scouthem es tu plataforma inteligente para centralizar y optimizar todo el proceso de selección.
        Automatiza la pre-selección con evaluaciones psicométricas de vanguardia para predecir el desempeño, y gestiona candidatos con nuestro avanzado ATS, todo en un solo lugar.
        Asegura contrataciones de alta calidad y una mejor experiencia para el candidato.
      </Reveal>

      <Reveal as="div" variant="fade-up" delay={240} class="pt-2">
        <a
          target="_blank"
          rel="noopener"
          href={SCOUTHEM_HREF}
          class="inline-block border border-verde-bosque/20 text-verde-bosque text-center font-semibold py-4 px-8 rounded-xl hover:bg-verde-bosque/5 transition-all"
        >
          Conoce nuestra plataforma SCOUTHEM
        </a>
      </Reveal>
    </div>

    <!-- Visual panel: below the text on mobile; left column at lg: via order.
         The image ships as webp (allowed by docs/frontend-standards.md §1);
         an avif output would break the hero-carousel contract test, which
         counts avif srcs in dist/index.html before the services section. -->
    <Reveal as="div" variant="fade-up" delay={320} class="lg:order-1">
      <div class="w-full aspect-[4/3] rounded-[2rem] bg-verde-bosque overflow-hidden">
        {
          dashboardImage ? (
            <Image
              src={dashboardImage}
              alt="Panel de la plataforma Scouthem con métricas de evaluación, embudo de candidatos y analítica de selección"
              width={dashboardImage.width}
              height={dashboardImage.height}
              widths={dashboardSrcsetWidths}
              format="webp"
              loading="lazy"
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="w-full h-full object-cover"
            />
          ) : null
        }
      </div>
    </Reveal>
  </div>
</section>
