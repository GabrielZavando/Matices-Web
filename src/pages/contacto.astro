---
import Layout from '../layouts/Layout.astro'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import { B2B_LEAD_FIELDS } from '../lib/leadPayload';
import RadioCard from '../components/ui/RadioCard.astro';
import CheckboxCard from '../components/ui/CheckboxCard.astro';
import Reveal from '../components/ui/Reveal.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY;

type Option = { value: string; label: string };

const servicesOfInterest: Option[] = [
  { value: 'Salud Laboral', label: 'Salud Laboral' },
  { value: 'Seleccion', label: 'Reclutamiento y Selección' },
  { value: 'Capacitacion', label: 'Capacitación y Formación' },
  { value: 'Evaluacion', label: 'Evaluación Psicométrica' },
];

const organizationalChallenges: Array<Option & { extraClass: string }> = [
  { value: 'Clima Laboral', label: 'Mejorar el clima laboral', extraClass: '' },
  { value: 'Cubrir Cargos', label: 'Dificultad para cubrir cargos', extraClass: '' },
  { value: 'Ausentismo', label: 'Reducir ausentismo laboral', extraClass: '' },
  { value: 'Capacitacion', label: 'Capacitar y alinear equipos', extraClass: '' },
  { value: 'Cumplimiento', label: 'Diagnóstico de riesgos y cumplimiento (Ley Karin, Istas21, etc.)', extraClass: 'md:col-span-2' },
];

const organizationSizes: Option[] = [
  { value: '1-10', label: '1-10' },
  { value: '11-50', label: '11-50' },
  { value: '51-200', label: '51-200' },
  { value: 'Más de 200', label: 'Más de 200' },
];

const contactPreferences: Option[] = [
  { value: 'Email', label: 'Email' },
  { value: 'Telefono', label: 'Teléfono' },
  { value: 'WhatsApp', label: 'WhatsApp' },
  { value: 'Reunion', label: 'Reunión' },
];
---

<Layout
  title="Matices - Hablemos de tu Organización"
  description="Completa nuestro formulario de calificación estratégica. Diseñamos propuestas metodológicas y comerciales adaptadas exactamente a tus desafíos."
>
  <Header activePath="/contacto" />

  <main class="relative overflow-hidden bg-contact-background text-contact-on-background selection:bg-contact-secondary-container selection:text-contact-on-secondary-fixed flex flex-col items-center w-full">
    <!-- Background Decorations -->
    <div class="h-[400px] w-[400px] rounded-full blur-[80px] opacity-[0.15] -z-10 pointer-events-none absolute bg-contact-secondary top-20 -left-20 animate-float [animation-delay:0ms]"></div>
    <div class="h-[400px] w-[400px] rounded-full blur-[80px] opacity-[0.15] -z-10 pointer-events-none absolute bg-contact-surface-tint bottom-40 -right-20 animate-float [animation-delay:2s]"></div>
    <div class="h-[400px] w-[400px] rounded-full blur-[80px] opacity-[0.15] -z-10 pointer-events-none absolute bg-contact-secondary-container top-1/2 left-1/2 transform -translate-x-1/2 animate-float [animation-delay:4s]"></div>

    <!-- Hero Intro -->
    <section class="max-w-4xl mx-auto px-[16px] md:px-0 pt-[80px] pb-[48px] text-center flex flex-col items-center">
      <div class="inline-flex items-center gap-2 bg-contact-secondary-container px-4 py-1 rounded-full text-contact-on-secondary-fixed mb-6">
        <span class="w-2 h-2 rounded-full bg-contact-secondary"></span>
        <span class="font-sans text-label-sm uppercase tracking-wider">Venta Consultiva B2B</span>
      </div>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-verde-bosque leading-tight mb-6">
        Hablemos de tu <span class="text-verde-lima font-normal italic">Organización</span>
      </h1>
      <p class="font-sans text-body-lg text-contact-on-surface-variant max-w-2xl mx-auto">
        Completa nuestro formulario de calificación estratégica. Diseñamos propuestas metodológicas y comerciales adaptadas exactamente a tus desafíos.
      </p>
    </section>

    <!-- Form Container -->
    <section class="w-full max-w-4xl mx-auto px-[16px] md:px-0 mb-[80px]">
      <div class="bg-contact-surface-container-lowest rounded-[3rem] py-8 md:py-12 shadow-[0_10px_40px_-10px_rgba(0,60,86,0.15)] w-full">
        
        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-12 w-full">
          <input type="hidden" name={B2B_LEAD_FIELDS.accessKey} value={accessKey} />
          <input type="hidden" name="subject" value="Nueva solicitud - Contacto Matices" />
          <!-- Honeypot Passive Spam Protection (Mandatory Rule) -->
          <input type="text" name={B2B_LEAD_FIELDS.honeypot} class="sr-only" autocomplete="off" tabindex="-1" />

          <!-- Section 1: Información de Identificación -->
          <Reveal as="div" variant="fade-up" delay={0} class="w-full">
            <div class="flex items-start gap-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-contact-primary flex items-center justify-center text-contact-on-primary font-bold shrink-0">1</div>
              <div>
                <h2 class="font-sans text-headline-md text-contact-primary">Información de Identificación</h2>
                <p class="font-sans text-body-md text-contact-outline">Tus datos corporativos básicos para establecer el contacto directo.</p>
                <p class="font-sans text-body-md text-contact-error mt-2 font-medium">Los campos señalados con un asterisco (*) rojo son obligatorios.</p>
              </div>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-[24px] w-full">
              <div class="space-y-2">
                <label for="nombre" class="font-sans text-label-md text-contact-on-surface block">NOMBRES Y APELLIDOS <span class="text-contact-error font-bold">*</span></label>
                <input 
                  id="nombre"
                  name={B2B_LEAD_FIELDS.name}
                  required
                  class="w-full bg-contact-surface-container-low border border-contact-surface-variant rounded-xl p-4 transition-all focus:outline-none focus:border-contact-primary focus:ring-4 focus:ring-contact-primary/10" 
                  placeholder="Ej. Juan Pérez" 
                  type="text"
                />
              </div>
              <div class="space-y-2">
                <label for="email" class="font-sans text-label-md text-contact-on-surface block">CORREO ELECTRÓNICO <span class="text-contact-error font-bold">*</span></label>
                <input 
                  id="email"
                  name="email"
                  required
                  class="w-full bg-contact-surface-container-low border border-contact-surface-variant rounded-xl p-4 transition-all focus:outline-none focus:border-contact-primary focus:ring-4 focus:ring-contact-primary/10" 
                  placeholder="Ej. j.perez@empresa.cl" 
                  type="email"
                />
              </div>
              <div class="space-y-2">
                <label for="telefono" class="font-sans text-label-md text-contact-on-surface block">TELÉFONO / WHATSAPP <span class="text-contact-error font-bold">*</span></label>
                <input 
                  id="telefono"
                  name={B2B_LEAD_FIELDS.phone}
                  required
                  class="w-full bg-contact-surface-container-low border border-contact-surface-variant rounded-xl p-4 transition-all focus:outline-none focus:border-contact-primary focus:ring-4 focus:ring-contact-primary/10" 
                  placeholder="Ej. +56 9 1234 5678" 
                  type="tel"
                />
              </div>
              <div class="space-y-2">
                <label for="empresa" class="font-sans text-label-md text-contact-on-surface block">EMPRESA / INSTITUCIÓN</label>
                <input 
                  id="empresa"
                  name={B2B_LEAD_FIELDS.company}
                  class="w-full bg-contact-surface-container-low border border-contact-surface-variant rounded-xl p-4 transition-all focus:outline-none focus:border-contact-primary focus:ring-4 focus:ring-contact-primary/10" 
                  placeholder="Ej. Empresa Ltda." 
                  type="text"
                />
              </div>
              <div class="md:col-span-2 space-y-2">
  <label for="cargo" class="font-sans text-label-md text-contact-on-surface block">CARGO EN LA ORGANIZACIÓN</label>
  <input 
    id="cargo"
    name={B2B_LEAD_FIELDS.role}
    class="w-full bg-contact-surface-container-low border border-contact-surface-variant rounded-xl p-4 transition-all focus:outline-none focus:border-contact-primary focus:ring-4 focus:ring-contact-primary/10" 
    placeholder="Ej. Gerente de Personas / Jefe de RRHH" 
    type="text"
  />
</div>
<div class="md:col-span-2 space-y-2 w-full">
  <label for="mensaje" class="font-sans text-label-md text-contact-on-surface block">MENSAJE</label>
  <textarea 
    id="mensaje"
    name={B2B_LEAD_FIELDS.message}
    class="w-full bg-contact-surface-container-low border border-contact-surface-variant rounded-xl p-4 transition-all focus:outline-none focus:border-contact-primary focus:ring-4 focus:ring-contact-primary/10" 
    placeholder="Escribe aquí cualquier detalle adicional..." 
    rows="4"
  ></textarea>
</div>
            </div>
          </Reveal>

          <!-- Section 2: Calificación de Requerimientos -->
          <Reveal as="div" variant="fade-up" delay={120} class="w-full">
            <div class="flex items-start gap-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-contact-primary flex items-center justify-center text-contact-on-primary font-bold shrink-0">2</div>
              <div class="min-w-0 flex-1">
                <h2 class="font-sans text-headline-md text-contact-primary flex flex-wrap items-center justify-between gap-4"><div class="flex flex-wrap items-center gap-2 min-w-0"><span>Calificación de Requerimientos</span> <span class="text-sm text-contact-on-surface-variant">(Opcional)</span></div> <button id="toggle-requerimientos" type="button" class="transform transition-transform cursor-pointer shrink-0" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-contact-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button></h2>
                <p class="font-sans text-body-md text-contact-outline">Cuéntanos sobre los servicios y problemáticas que buscas resolver.</p>
              </div>
            </div>
            
            <div id="content-requerimientos" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
              <div class="overflow-hidden min-h-0 space-y-8 w-full">
              <!-- Servicios de Interés -->
              <fieldset class="w-full space-y-4">
                <legend class="font-sans text-label-md text-contact-on-surface block mb-4 uppercase">SERVICIOS DE INTERÉS (SELECCIONA UNO O MÁS)</legend>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                  
                  {servicesOfInterest.map((option) => (
                    <CheckboxCard name={B2B_LEAD_FIELDS.servicesOfInterest} value={option.value} label={option.label} />
                  ))}

                </div>
              </fieldset>

              <!-- Desafíos Organizacionales -->
              <fieldset class="w-full space-y-4">
                <legend class="font-sans text-label-md text-contact-on-surface block mb-4 uppercase">DESAFÍOS ORGANIZACIONALES (SELECCIONA TUS PRINCIPALES FOCOS)</legend>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
                  
                  {organizationalChallenges.map((option) => (
                    <CheckboxCard name={B2B_LEAD_FIELDS.organizationalChallenges} value={option.value} label={option.label} extraClass={option.extraClass} />
                  ))}

                </div>
              </fieldset>
              </div>
            </div>
          </Reveal>
          <!-- Section 3: Tamaño y Preferencia -->
          <Reveal as="div" variant="fade-up" delay={240} class="space-y-8 w-full">
            <div class="flex items-start gap-4 mb-8">
              <div class="w-10 h-10 rounded-full bg-contact-primary flex items-center justify-center text-contact-on-primary font-bold shrink-0">3</div>
              <div class="min-w-0 flex-1">
                <h2 class="font-sans text-headline-md text-contact-primary flex flex-wrap items-center justify-between gap-4"><div class="flex flex-wrap items-center gap-2 min-w-0"><span>Detalles de Contacto</span> <span class="text-sm text-contact-on-surface-variant">(Opcional)</span></div> <button id="toggle-detalles" type="button" class="transform transition-transform cursor-pointer shrink-0" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-contact-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg></button></h2>
                <p class="font-sans text-body-md text-contact-outline">Ayúdanos a personalizar nuestra respuesta.</p>
              </div>
            </div>
            
            <div id="content-detalles" class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
              <div class="overflow-hidden min-h-0 space-y-8 w-full">
              <!-- Tamaño de la Organización -->
              <fieldset class="w-full space-y-4">
                <legend class="font-sans text-label-md text-contact-on-surface block mb-4 uppercase">TAMAÑO DE LA ORGANIZACIÓN</legend>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 w-full">
                  
                  {organizationSizes.map((option) => (
                    <RadioCard name={B2B_LEAD_FIELDS.organizationSize} value={option.value} label={option.label} variant="size" />
                  ))}

                </div>
              </fieldset>

              <!-- Preferencia de Contacto -->
              <fieldset class="w-full space-y-4">
                <legend class="font-sans text-label-md text-contact-on-surface block mb-4 uppercase">PREFERENCIA DE CONTACTO</legend>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 w-full">
                  
                  {contactPreferences.map((option) => (
                    <RadioCard name={B2B_LEAD_FIELDS.contactPreference} value={option.value} label={option.label} variant="preference" />
                  ))}

                </div>
              </fieldset>
              </div>


            </div>
          </Reveal>

          <!-- Bottom Actions with Overlapping Circle Design -->
          <Reveal as="div" variant="fade-up" delay={360} class="pt-8 border-t border-contact-surface-variant flex flex-col items-center gap-6 relative w-full overflow-hidden">
            <p class="text-center font-sans text-body-md text-contact-outline max-w-lg relative z-10 leading-relaxed">
              Tus datos comerciales serán procesados con absoluta confidencialidad por el equipo corporativo de Matices Consultoría.
            </p>
            
            <div class="w-full flex justify-center relative z-10">
              <button 
                class="bg-contact-primary text-contact-on-primary px-12 py-4 rounded-full font-sans text-label-md font-bold uppercase tracking-widest hover:shadow-lg hover:shadow-primary/20 active:scale-95 transition-all w-full md:w-auto cursor-pointer" 
                type="submit"
              >
                Enviar Solicitud
              </button>
            </div>
            
            <a 
              class="text-contact-primary font-sans text-label-md border-b border-primary hover:border-transparent transition-all relative z-10" 
              href="mailto:contacto@maticesconsultora.cl"
            >
              contacto@maticesconsultora.cl
            </a>

          </Reveal>
        </form>
      </div>
    </section>

    <!-- Additional Ambient Decor -->
    <div class="absolute bottom-0 left-1/2 transform -translate-x-1/2 opacity-20 pointer-events-none mb-[80px]">
      <div class="flex -space-x-20">
        <div class="w-64 h-64 rounded-full bg-contact-secondary animate-float [animation-delay:1s]"></div>
        <div class="w-64 h-64 rounded-full bg-contact-accent-orange animate-float [animation-delay:3s]"></div>
        <div class="w-64 h-64 rounded-full bg-contact-tertiary animate-float [animation-delay:5s]"></div>
      </div>
    </div>

    <!-- Native Feedback Modal -->
    <div 
      id="feedback-modal" 
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300"
      role="dialog" 
      aria-modal="true" 
      aria-hidden="true"
    >
      <div class="bg-contact-surface-container-lowest rounded-[2rem] p-8 max-w-md w-full border border-contact-surface-variant shadow-2xl transform scale-95 transition-all duration-300 flex flex-col items-center text-center relative overflow-hidden">
        
        <!-- 1. Estado de Advertencia (Campos Incompletos) -->
        <div id="modal-warning" class="hidden flex flex-col items-center w-full">
          <div class="w-16 h-16 rounded-full bg-amber-100 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
          <h3 class="font-sans text-headline-md text-contact-primary mb-3">Campos Incompletos</h3>
          <p class="font-sans text-body-md text-contact-outline mb-6 leading-relaxed">
            No podemos procesar tu solicitud porque faltan rellenar algunos campos obligatorios marcados con asterisco rojo.
          </p>
        </div>

        <!-- 2. Estado de Éxito (Envío Correcto) -->
        <div id="modal-success" class="hidden flex flex-col items-center w-full">
          <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="font-sans text-headline-md text-contact-primary mb-3">¡Envío Exitoso!</h3>
          <p class="font-sans text-body-md text-contact-outline mb-6 leading-relaxed">
            Tu mensaje ha sido enviado correctamente. Nos pondremos en contacto contigo a la brevedad para abordar los desafíos de tu organización.
          </p>
        </div>

        <!-- 3. Estado de Error (Fallo de Red) -->
        <div id="modal-error" class="hidden flex flex-col items-center w-full">
          <div class="w-16 h-16 rounded-full bg-red-100 flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <h3 class="font-sans text-headline-md text-contact-primary mb-3">Error de Conexión</h3>
          <p class="font-sans text-body-md text-contact-outline mb-6 leading-relaxed">
            Hubo un problema de comunicación al transmitir tu solicitud. Por favor, comprueba tu conexión a internet o inténtalo más tarde.
          </p>
        </div>

        <!-- Botón de Cierre Común -->
        <button 
          id="modal-close-btn" 
          class="bg-contact-primary text-contact-on-primary px-8 py-3 rounded-full font-sans text-label-md font-bold uppercase tracking-wider hover:shadow-lg hover:shadow-primary/20 active:scale-95 transition-all w-full cursor-pointer focus:outline-none focus:ring-4 focus:ring-contact-primary/20"
        >
          Entendido
        </button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>


<script>
  import { isHoneypotClean, getMissingRequired } from '../lib/leadPayload';
  import { formatPhoneNumber, isPhoneNumberFormatValid } from '../lib/formValidation';

  // Radio selection styling is handled via CSS :has(); no JS required.

  // Modal DOM Elements and Controls
  const modal = document.getElementById('feedback-modal')
  const warning = document.getElementById('modal-warning')
  const success = document.getElementById('modal-success')
  const error = document.getElementById('modal-error')
  const closeBtn = document.getElementById('modal-close-btn')

  let lastFocused: Element | null = null;

  function trapFocus(e: KeyboardEvent) {
    if (e.key !== 'Tab' || !modal) return;
    const focusable = modal.querySelectorAll<HTMLElement>(
      'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
    );
    if (focusable.length === 0) return;
    const first = focusable[0]!;
    const last = focusable[focusable.length - 1]!;
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  function openModal(state: 'warning' | 'success' | 'error') {
    if (!modal || !warning || !success || !error) return

    lastFocused = document.activeElement;

    warning.classList.add('hidden')
    success.classList.add('hidden')
    error.classList.add('hidden')

    if (state === 'warning') {
      warning.classList.remove('hidden')
    } else if (state === 'success') {
      success.classList.remove('hidden')
      // Retrigger the icon "pop" animation on every open
      const icon = success.querySelector('div')
      if (icon) {
        icon.classList.remove('animate-scale-in')
        void icon.offsetWidth
        icon.classList.add('animate-scale-in')
      }
    } else if (state === 'error') {
      error.classList.remove('hidden')
    }

    modal.classList.remove('opacity-0', 'pointer-events-none')
    modal.classList.add('opacity-100', 'pointer-events-auto')
    modal.setAttribute('aria-hidden', 'false')

    const card = modal.querySelector('div')
    if (card) {
      card.classList.remove('scale-95')
      card.classList.add('scale-100')
    }

    if (closeBtn) closeBtn.focus()
  }

  function closeModal() {
    if (!modal) return
    modal.classList.remove('opacity-100', 'pointer-events-auto')
    modal.classList.add('opacity-0', 'pointer-events-none')
    modal.setAttribute('aria-hidden', 'true')

    const card = modal.querySelector('div')
    if (card) {
      card.classList.remove('scale-100')
      card.classList.add('scale-95')
    }

    if (lastFocused && 'focus' in lastFocused) {
      (lastFocused as HTMLElement).focus()
    }
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeModal)
  }

  if (modal) {
    modal.addEventListener('click', (e: Event) => {
      if (e.target === modal) {
        closeModal()
      }
    })

    modal.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        closeModal()
        return
      }
      trapFocus(e)
    })
  }

  // Teléfono Auto-Formatter
  const telInputHandler = document.getElementById('telefono') as HTMLInputElement;
  if (telInputHandler) {
    telInputHandler.addEventListener('input', (e) => {
      (e.target as HTMLInputElement).value = formatPhoneNumber((e.target as HTMLInputElement).value);
    });
  }

  // Reactively validate required fields (.touched state)
  const requiredInputs = document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('#nombre, #email, #telefono')

  requiredInputs.forEach(input => {
    input.addEventListener('blur', () => {
      input.classList.add('touched')
      validateField(input)
    })

    input.addEventListener('input', () => {
      if (input.classList.contains('touched')) {
        validateField(input)
      }
    })
  })

  function validateField(field: HTMLInputElement | HTMLTextAreaElement) {
    if (field.id === 'telefono') {
      if (!isPhoneNumberFormatValid(field.value) && field.value !== '') {
        field.setCustomValidity('Número de teléfono inválido.');
      } else {
        field.setCustomValidity('');
      }
    }

    if (!field.checkValidity()) {
      field.classList.add('border-contact-error')
      field.classList.remove('border-contact-surface-variant')
    } else {
      field.classList.remove('border-contact-error')
      field.classList.add('border-contact-surface-variant')
    }
  }

  const form = document.querySelector('form')

  if (form) {
    form.addEventListener('submit', async (e: Event) => {
      e.preventDefault()

      // Forzar validación visual en todos los campos requeridos al enviar
      requiredInputs.forEach(input => {
        input.classList.add('touched')
        validateField(input)
      })

      // Evaluar si todo el formulario cumple con las restricciones HTML5
      if (!form.checkValidity()) {
        openModal('warning')
        return
      }

      // Validación de contrato: honeypot limpio y campos requeridos presentes
      const formData = new FormData(form)
      if (!isHoneypotClean(formData) || getMissingRequired(formData).length > 0) {
        openModal('warning')
        return
      }

      try {
        const endpoint = form.action || 'https://api.web3forms.com/submit'
        
        const response = await fetch(endpoint, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        })

        if (response.ok) {
          form.reset()
          // Limpiar clases de estado de validación
          requiredInputs.forEach(input => {
            input.classList.remove('touched', 'border-contact-error')
            input.classList.add('border-contact-surface-variant')
          })
          openModal('success')
        } else {
          openModal('error')
        }
      } catch (err) {
        console.error('Error al enviar:', err)
        openModal('error')
      }
    })
  }

// Collapsible sections for optional parts
function setupCollapsible(toggleId: string, contentId: string) {
  const btn = document.getElementById(toggleId);
  const content = document.getElementById(contentId);
  if (!btn || !content) return;
  const arrow = btn.querySelector('svg');
  
  btn.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    if (expanded) {
      content.classList.add('grid-rows-[0fr]');
      content.classList.remove('grid-rows-[1fr]');
      if (arrow) arrow.classList.remove('rotate-180');
    } else {
      content.classList.remove('grid-rows-[0fr]');
      content.classList.add('grid-rows-[1fr]');
      if (arrow) arrow.classList.add('rotate-180');
    }
  });
}
setupCollapsible('toggle-requerimientos','content-requerimientos');
setupCollapsible('toggle-detalles','content-detalles');
</script>
