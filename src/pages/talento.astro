---
import Layout from '../layouts/Layout.astro'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import { Image } from 'astro:assets'
import CompanyLogos from '../components/global/CompanyLogos.astro'
import Reveal from '../components/ui/Reveal.astro'

// Optimized image import
import directora from '../assets/directora.jpeg'

// Optimized gallery images imports
import imgRecruitment from '../assets/reclutamiento.jpg'
import imgCompetencies from '../assets/competencias.jpg'
import imgAssessment from '../assets/gallery/03.jpeg'
import imgPerformance from '../assets/desempeno.jpg'
import imgDevelopment from '../assets/planes-desarrollo.jpg'

const talentServices = [
  {
    image: imgRecruitment,
    alt: 'Reunión de selección estratégica de talento humano en oficina ejecutiva',
    title: 'Reclutamiento y Selección',
    description: 'Identificamos y atraemos a los profesionales idóneos para cargos ejecutivos, mandos medios y perfiles especializados de alta exigencia técnica.',
    href: '/contacto',
  },
  {
    image: imgCompetencies,
    alt: 'Evaluación de competencias laborales con metodologías Matices',
    title: 'Evaluación de Competencias',
    description: 'Analizamos de forma exhaustiva las capacidades de tus colaboradores frente a perfiles de cargo específicos para maximizar el ajuste y rendimiento.',
    href: '/contacto',
  },
  {
    image: imgAssessment,
    alt: 'Assessment psicológico y psicométrico avanzado para selección de personal',
    title: 'Assessment y Psicometría',
    description: 'Medimos aptitudes, personalidad y rasgos cognitivos mediante pruebas avanzadas y simulaciones conductuales con validez estadística comprobada.',
    href: '/contacto',
  },
  {
    image: imgPerformance,
    alt: 'Gestión del desempeño organizacional con métricas y KPIs',
    title: 'Gestión del Desempeño',
    description: 'Diseñamos sistemas objetivos de evaluación del desempeño para alinear los aportes individuales con las metas estratégicas de tu empresa.',
    href: '/contacto',
  },
  {
    image: imgDevelopment,
    alt: 'Plan de desarrollo profesional y crecimiento en organizaciones',
    title: 'Planes de Desarrollo',
    description: 'Estructuramos planes individuales y grupales de desarrollo y sucesión para cerrar brechas técnicas y potenciar futuros líderes.',
    href: '/contacto',
  },
];
---

<Layout
  title="Gestión de Talento"
  description="Matices Consultoría - Servicios de headhunting, reclutamiento estratégico y selección de perfiles ejecutivos B2B en Chile."
>
  <Header activePath="/talento" />

  <main class="w-full">
    <!-- Hero Section -->
    <section
      class="relative w-full overflow-hidden pt-12 pb-24 md:pt-20 md:pb-32 bg-radial from-verde-lima/5 to-transparent"
    >
      <div class="absolute -top-10 -left-10 h-48 w-48 rounded-full bg-verde-lima/10 blur-3xl -z-10 pointer-events-none animate-float"></div>
      <div
        class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Hero Copy -->
        <div class="lg:col-span-7 space-y-6 z-10 text-left">
          <Reveal as="span" variant="fade-up" delay={0} class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Talento &amp; Selección Estratégica
          </Reveal>
          <Reveal as="h1" variant="fade-up" delay={80} class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-verde-bosque leading-tight">
            Te Asesoramos en <span class="text-verde-lima font-normal italic"
              >Gestión del Talento</span
            >
          </Reveal>
          <Reveal as="p" variant="fade-up" delay={160} class="font-sans text-lg text-verde-bosque/80 max-w-xl leading-relaxed">
            Diseñamos soluciones integrales de atracción y evaluación bajo los más altos estándares de calidad metodológica y base científica. Contamos con herramientas y dinámicas avanzadas para analizar, potenciar y retener el talento estratégico clave para el éxito y la sostenibilidad de tu negocio.
          </Reveal>
          <Reveal as="div" variant="fade-up" delay={240} class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href="/contacto"
              class="bg-verde-bosque text-white font-sans text-center font-semibold py-4 px-8 rounded-xl hover:opacity-90 active:scale-95 transition-all text-sm block"
            >
              Iniciar un Proceso
            </a>
          </Reveal>
        </div>

        <!-- Graphic Content -->
        <Reveal as="div" variant="scale-in" delay={120} class="lg:col-span-5 relative w-full flex justify-center">
          <div
            class="w-full max-w-md aspect-[4/5] rounded-[3rem] overflow-hidden shadow-2xl relative border-4 border-white/40"
          >
            <Image
              src={directora}
              alt="Líder ejecutivo en reunión estratégica de selección"
              width={640}
              height={800}
              format="avif"
              loading="eager"
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
              class="w-full h-full object-cover"
            />
          </div>
          <Reveal as="div" variant="fade-up" delay={320} class="absolute -bottom-6 -right-6 bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-xl border border-verde-bosque/10 max-w-[200px] hidden sm:block animate-float">
            <p class="font-heading text-xl font-bold text-verde-bosque mb-1">
              98%
            </p>
            <p class="text-sm font-semibold text-verde-bosque/70 leading-tight">
              Tasa de retención en cargos colocados.
            </p>
          </Reveal>
        </Reveal>
      </div>
    </section>

    <!-- Sección Superior de Asesoría & Scouthem -->
    <section id="asesoria" class="w-full py-20 bg-white border-t border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Cabecera Informativa -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <Reveal as="div" variant="fade-up" class="lg:col-span-5 space-y-4">
            <span class="inline-block px-4 py-1.5 rounded-full bg-azul-celeste/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
              Asesoría de Gestión del Talento
            </span>
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque leading-tight">
              Te Asesoramos en <span class="text-verde-lima font-normal italic">Gestión del Talento</span>
            </h2>
          </Reveal>
          <div class="lg:col-span-7 lg:pt-8">
            <p class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed">
              Diseñamos soluciones integrales de atracción y evaluación bajo los más altos estándares de calidad metodológica y base científica. Contamos con herramientas y dinámicas avanzadas para analizar, potenciar y retener el talento estratégico clave para el éxito y la sostenibilidad de tu negocio B2B.
            </p>
          </div>
        </div>

        <!-- Subbloque Scouthem (IA & Psicometría Avanzada) -->
          <Reveal as="div" variant="fade-up" class="bg-crema-calido/50 p-8 md:p-12 rounded-[2.5rem] border border-verde-bosque/5 hover:border-verde-bosque/10 transition-all duration-300">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              
              <div class="lg:col-span-8 space-y-4">
                <span class="inline-block px-3 py-1 rounded-full bg-verde-lima/20 text-verde-bosque font-sans text-xs font-bold uppercase tracking-wider">
                  Representantes Exclusivos Regionales
                </span>
                <h3 class="font-heading text-2xl md:text-3xl font-bold text-verde-bosque">
                  Scouthem – IA y Psicometría Avanzada
                </h3>
                <p class="font-sans text-sm md:text-base text-verde-bosque/75 max-w-2xl leading-relaxed">
                  Revolucionamos la evaluación de talentos integrando algoritmos de Inteligencia Artificial con los principios más rigurosos de la psicometría moderna. Optimiza tus filtros de selección y obtén diagnósticos conductuales profundos con el respaldo exclusivo de nuestra acreditación regional.
                </p>
              </div>

              <div class="lg:col-span-4 flex justify-start lg:justify-end w-full">
                <a 
                  href="/testing#scouthem" 
                  class="w-full sm:w-auto bg-verde-bosque hover:bg-verde-bosque/90 text-white font-sans font-bold py-4 px-8 rounded-xl shadow-lg transition-all hover:-translate-y-0.5 hover:shadow-xl active:scale-95 text-center text-sm inline-block uppercase tracking-wider"
                >
                  CONOCER SCOUTHEM
                </a>
              </div>

            </div>
          </Reveal>

      </div>
    </section>

    <!-- Sección de Servicios de Talento -->
    <section id="servicios" class="w-full py-20 bg-crema-calido/30 border-t border-b border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Encabezado de la Sección -->
        <Reveal as="div" variant="fade-up" class="text-center space-y-3 max-w-2xl mx-auto">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Nuestros Servicios
          </span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque">
            SERVICIOS DE TALENTO
          </h2>
          <p class="font-sans text-base text-verde-bosque/75">
            Soluciones metodológicas integrales diseñadas para diagnosticar, evaluar y potenciar a tus colaboradores bajo una mirada estratégica y científica.
          </p>
        </Reveal>

        <!-- Tarjetas de Servicios (mapeadas desde talentServices) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {talentServices.slice(0, 3).map((service, i) => (
            <Reveal as="article" variant="fade-up" delay={i * 80} class="bg-white rounded-[2.5rem] shadow-md border border-verde-bosque/5 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group">
              <div class="w-full h-48 overflow-hidden relative">
                <Image
                  src={service.image}
                  alt={service.alt}
                  width={640}
                  height={360}
                  format="avif"
                  loading="lazy"
                  sizes="(max-width: 768px) 100vw, 50vw"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-8 flex flex-col justify-between flex-grow space-y-4">
                <div class="space-y-2">
                  <h3 class="font-heading text-xl md:text-2xl font-bold text-verde-bosque group-hover:text-verde-lima transition-colors duration-300">
                    {service.title}
                  </h3>
                  <p class="font-sans text-sm text-verde-bosque/75 leading-relaxed">
                    {service.description}
                  </p>
                </div>
                <a 
                  href={service.href} 
                  class="text-verde-bosque hover:text-verde-lima font-sans font-bold text-sm tracking-wider uppercase inline-flex items-center gap-2 group/btn mt-auto"
                >
                  Contactar Aquí
                  <svg class="h-4 w-4 transform group-hover/btn:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Reveal>
          ))}
        </div>

        <!-- Últimas 2 tarjetas (centradas en pantallas grandes) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {talentServices.slice(3).map((service, i) => (
            <Reveal as="article" variant="fade-up" delay={i * 80} class="bg-white rounded-[2.5rem] shadow-md border border-verde-bosque/5 overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group">
              <div class="w-full h-48 overflow-hidden relative">
                <Image
                  src={service.image}
                  alt={service.alt}
                  width={640}
                  height={360}
                  format="avif"
                  loading="lazy"
                  sizes="(max-width: 768px) 100vw, 50vw"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="p-8 flex flex-col justify-between flex-grow space-y-4">
                <div class="space-y-2">
                  <h3 class="font-heading text-xl md:text-2xl font-bold text-verde-bosque group-hover:text-verde-lima transition-colors duration-300">
                    {service.title}
                  </h3>
                  <p class="font-sans text-sm text-verde-bosque/75 leading-relaxed">
                    {service.description}
                  </p>
                </div>
                <a 
                  href={service.href} 
                  class="text-verde-bosque hover:text-verde-lima font-sans font-bold text-sm tracking-wider uppercase inline-flex items-center gap-2 group/btn mt-auto"
                >
                  Contactar Aquí
                  <svg class="h-4 w-4 transform group-hover/btn:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Componente Reutilizable: Clientes / Prueba Social -->
    <CompanyLogos />
  </main>

  <Footer />
</Layout>
