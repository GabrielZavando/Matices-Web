---
import Layout from '../layouts/Layout.astro'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import { Image } from 'astro:assets'
import CompanyLogos from '../components/global/CompanyLogos.astro'
import Reveal from '../components/ui/Reveal.astro'

// Optimized image import
import directoraMatices from '../assets/directora-matices.jpeg'
import collaborativeWorkshop from '../assets/collaborative-workshop.webp'

interface ClinicalService {
  title: string
  icon: string
  iconBg: string
  bullets: string[]
}

const clinicalServices: ClinicalService[] = [
  {
    title: 'Psicoterapia y Atención Clínica',
    icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
    iconBg: 'bg-verde-lima/10 group-hover:bg-verde-lima/20',
    bullets: [
      'Atención individual para jóvenes y adultos.',
      'Terapia de pareja y orientación familiar integral.',
      'Tratamiento de ansiedad, estrés y burnout laboral.',
    ],
  },
  {
    title: 'Evaluaciones y Diagnóstico',
    icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    iconBg: 'bg-azul-celeste/10 group-hover:bg-azul-celeste/20',
    bullets: [
      'Evaluaciones neuropsicológicas cognitivas.',
      'Aplicación de test proyectivos y psicométricos.',
      'Informes psicológicos para fines laborales y clínicos.',
    ],
  },
  {
    title: 'Formación y Desarrollo',
    icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253',
    iconBg: 'bg-verde-lima/10 group-hover:bg-verde-lima/20',
    bullets: [
      'Supervisión clínica para profesionales y egresados.',
      'Coaching ontológico y ejecutivo para liderazgo.',
      'Talleres de autocuidado y manejo emocional práctico.',
    ],
  },
]

const psychAreas: string[] = [
  'Reclutamiento y Selección',
  'Evaluación Psicológica',
  'Capacitación y Formación',
  'Gestión del Talento',
  'Clima Organizacional',
  'Salud Laboral',
  'Gestión del Cambio Organizacional',
]
---

<Layout
  title="Psicología Laboral Aplicada"
  description="Matices Consultoría - Programas de salud mental corporativa, bienestar integral, evaluaciones psicológicas e intervención en clima laboral."
>
  <Header activePath="/psicologia" />

  <main class="w-full">
    <!-- Hero Section -->
    <section
      class="relative w-full overflow-hidden pt-12 pb-24 md:pt-20 md:pb-32 bg-radial from-verde-lima/5 to-transparent"
    >
      <div class="absolute -top-10 -right-10 h-48 w-48 rounded-full bg-verde-lima/10 blur-3xl -z-10 pointer-events-none animate-float"></div>
      <div
        class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Hero Copy -->
        <div class="lg:col-span-7 space-y-6 z-10 text-left">
          <Reveal as="span" variant="fade-up" delay={0} class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Bienestar &amp; Salud Mental
          </Reveal>
          <Reveal as="h1" variant="fade-up" delay={80} class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-verde-bosque leading-tight">
            Psicología Laboral <span class="text-verde-lima font-normal italic"
              >Aplicada</span
            >
          </Reveal>
          <Reveal as="p" variant="fade-up" delay={160} class="font-sans text-lg text-verde-bosque/80 max-w-xl leading-relaxed">
            Fomentamos entornos de trabajo saludables y productivos. Diseñamos
            programas de intervención, apoyo psicológico y diagnóstico de clima
            con base clínico-científica para promover el bienestar de tus
            colaboradores(as).
          </Reveal>
          <Reveal as="div" variant="fade-up" delay={240} class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              href="https://encuadrado.com/p/psicologa-maria-jose-jimenez"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-verde-bosque text-white font-sans text-center font-semibold py-4 px-8 rounded-xl hover:opacity-90 active:scale-95 transition-all text-sm block"
            >
              Agendar hora online
            </a>
          </Reveal>
        </div>

        <!-- Graphic Content -->
        <Reveal as="div" variant="scale-in" delay={120} class="lg:col-span-5 relative w-full flex justify-center">
          <div
            class="w-full max-w-md aspect-[4/5] rounded-[3rem] overflow-hidden shadow-2xl relative border-4 border-white/40"
          >
            <Image
              src={directoraMatices}
              alt="Especialista liderando sesión de psicología organizacional y dinámicas de grupo"
              width={640}
              height={800}
              format="avif"
              loading="eager"
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
              class="w-full h-full object-cover"
            />
          </div>
          <Reveal as="div" variant="fade-up" delay={320} class="absolute -bottom-6 -right-6 bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-xl border border-verde-bosque/10 max-w-[200px] hidden sm:block animate-float">
            <p class="font-heading text-xl font-bold text-verde-bosque mb-1">
              +15 Años
            </p>
            <p class="text-sm font-semibold text-verde-bosque/70 leading-tight">
              De experiencia en psicología clínica y organizacional aplicada.
            </p>
          </Reveal>
        </Reveal>
      </div>
    </section>

    <!-- Sección Superior de Salud Mental & Ocupacional -->
    <section id="salud-mental" class="w-full py-20 bg-white border-t border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Cabecera Informativa -->
        <Reveal as="div" variant="fade-up" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5 space-y-4">
            <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
              Salud Mental y Ocupacional
            </span>
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque leading-tight">
              Atención Integral para <span class="text-verde-lima font-normal italic">Personas y Organizaciones</span>
            </h2>
          </div>
          <div class="lg:col-span-7 lg:pt-8">
            <p class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed">
              Ofrecemos un espacio de acompañamiento profesional y diagnóstico clínico-organizacional con un enfoque ético, científico y personalizado. Nos especializamos en la atención de personas, parejas, familias y profesionales, así como en el diseño de programas preventivos que promueven entornos laborales más saludables, equilibrados y productivos.
            </p>
          </div>
        </Reveal>

        <!-- Catálogo de Servicios Clínicos (3 Columnas) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {clinicalServices.map((service, i) => (
            <Reveal as="article" variant="fade-up" delay={i * 80} class="bg-white p-8 rounded-[2.5rem] border border-verde-bosque/5 shadow-md flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition-all duration-300 min-h-[320px] group">
              <div class="space-y-6">
                <div class={`w-12 h-12 rounded-2xl ${service.iconBg} flex items-center justify-center text-verde-bosque transition-all`}>
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
                  </svg>
                </div>
                <div class="space-y-3">
                  <h3 class="font-heading text-xl md:text-2xl font-bold text-verde-bosque group-hover:text-verde-lima transition-colors duration-300">
                    {service.title}
                  </h3>
                  <ul class="space-y-2 font-sans text-sm text-verde-bosque/75 leading-relaxed">
                    {service.bullets.map((bullet) => (
                      <li class="flex items-start gap-2">
                        <span class="text-verde-lima mt-1">✓</span>
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </Reveal>
          ))}
        </div>

        <!-- Bloque Destacado: Atención Médica y Telemedicina -->
        <Reveal as="div" variant="fade-up" class="mt-16 bg-crema-calido/50 p-8 md:p-12 rounded-[2.5rem] border border-verde-bosque/5 hover:border-verde-bosque/10 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <div class="lg:col-span-8 space-y-4">
              <span class="inline-block px-3 py-1 rounded-full bg-verde-lima/20 text-verde-bosque font-sans text-xs font-bold uppercase tracking-wider">
                Atención Médica &amp; Telemedicina
              </span>
              <h3 class="font-heading text-2xl md:text-3xl font-bold text-verde-bosque">
                Consulta Médica y Psiquiátrica Online
              </h3>
              <p class="font-sans text-sm md:text-base text-verde-bosque/75 max-w-2xl leading-relaxed">
                Complementamos el apoyo psicoterapéutico con la atención médica especializada a través de nuestra plataforma de telemedicina. Accede a consultas con profesionales acreditados en salud mental y ocupacional con la máxima flexibilidad y total confidencialidad.
              </p>
            </div>

            <div class="lg:col-span-4 flex justify-start lg:justify-end w-full">
              <a 
                href="https://telemedicina.maticesconsultores.cl" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-full sm:w-auto bg-verde-bosque hover:bg-verde-bosque/90 text-white font-sans font-bold py-4 px-8 rounded-xl shadow-lg transition-all hover:-translate-y-0.5 hover:shadow-xl active:scale-95 text-center text-sm inline-block uppercase tracking-wider"
              >
                AGENDAR HORA ONLINE
              </a>
            </div>

          </div>
        </Reveal>
      </div>

    </section>

    <!-- Banner de Dolor / Empatía (Intermedio) -->
    <section class="w-full py-20 bg-[#2e3131] text-crema-calido relative overflow-hidden shadow-xl">
      <div class="absolute top-0 right-0 w-96 h-96 bg-verde-lima/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-azul-celeste/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
      
      <Reveal as="div" variant="fade-up" class="max-w-[1280px] mx-auto px-4 md:px-16 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-6">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 text-crema-calido font-sans text-xs font-semibold uppercase tracking-widest">
            Bienestar Organizacional B2B
          </span>
          <h2 class="font-heading text-3xl md:text-5xl font-bold leading-tight">
            ¿Cómo impacta el bienestar psicológico en la productividad de tu empresa?
          </h2>
          <p class="font-sans text-base md:text-lg text-crema-calido/80 max-w-3xl leading-relaxed">
            El ausentismo laboral, la rotación constante y el estrés crónico (burnout) no solo afectan la salud mental de tus colaboradores, sino que representan costos invisibles altísimos para el negocio. Diseñamos planes estratégicos y preventivos de contención, autocuidado y salud laboral adaptados a la realidad de tu organización. Hablemos hoy para construir un entorno de trabajo saludable y sostenible.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 justify-start lg:justify-end w-full">
          <a 
            href="/contacto" 
            class="bg-verde-lima hover:bg-verde-lima/90 text-verde-bosque font-sans font-bold py-4 px-10 rounded-full hover:scale-105 transition-all shadow-lg text-center w-full block uppercase tracking-wider"
          >
            HABLEMOS AHORA
          </a>
        </div>
      </Reveal>
    </section>

    <!-- Sección de Áreas de Especialización B2B -->
    <section id="especialidades" class="w-full py-20 bg-crema-calido/30 border-b border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Columna Informativa -->
        <Reveal as="div" variant="fade-up" class="lg:col-span-7 space-y-6 text-left">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Especialización Organizacional
          </span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque leading-tight">
            Nuestras 7 Áreas Clave de <span class="text-verde-lima font-normal italic">Intervención y Consultoría</span>
          </h2>
          <p class="font-sans text-base text-verde-bosque/80 leading-relaxed">
            Ofrecemos un portafolio completo de soluciones en psicología del trabajo diseñadas para responder con precisión y rigor metodológico a cada una de las necesidades del ciclo de vida del colaborador en tu organización.
          </p>
          
          <!-- Grid de Especialidades -->
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {psychAreas.map((area, i) => (
              <Reveal
                as="li"
                variant="fade-up"
                delay={i * 80}
                class:list={[
                  'flex items-center gap-3 bg-white p-3 rounded-xl border border-verde-bosque/5 shadow-sm',
                  i === psychAreas.length - 1 ? 'sm:col-span-2' : '',
                ]}
              >
                <span class="w-2 h-2 rounded-full bg-verde-lima shrink-0"></span>
                <span class="font-sans text-sm font-semibold text-verde-bosque">{area}</span>
              </Reveal>
            ))}
          </ul>

          <div class="pt-4">
            <a 
              href="/contacto" 
              class="bg-verde-bosque text-white font-sans text-center font-bold py-4 px-10 rounded-xl hover:opacity-90 active:scale-95 transition-all text-sm inline-block uppercase tracking-wider shadow-lg"
            >
              HABLEMOS AHORA
            </a>
          </div>
        </Reveal>

        <!-- Columna de Imagen -->
        <Reveal as="div" variant="scale-in" delay={120} class="lg:col-span-5 relative w-full flex justify-center">
          <div class="w-full max-w-md aspect-[4/5] rounded-[3rem] overflow-hidden shadow-2xl relative border-4 border-white/40">
            <Image 
              src={collaborativeWorkshop} 
              alt="Especialistas de Matices liderando un taller de Clima Organizacional y Salud Laboral con colaboradores" 
              width={640}
              height={800}
              format="avif"
              loading="lazy"
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -right-6 bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-xl border border-verde-bosque/10 max-w-[200px] hidden sm:block animate-float">
            <p class="font-heading text-xl font-bold text-verde-bosque mb-1">
              7 Áreas
            </p>
            <p class="text-sm font-semibold text-verde-bosque/70 leading-tight">
              De intervención estratégica para el desarrollo corporativo.
            </p>
          </div>
        </Reveal>
      </div>

    </section>

    <!-- Componente Reutilizable: Clientes / Prueba Social -->
    <CompanyLogos />
  </main>

  <Footer />
</Layout>
