---
import { Image } from 'astro:assets'
import logoImage from '../../assets/logo.webp'

interface Props {
  activePath?: string;
}

const { activePath = "" } = Astro.props;

const navItems = [
  { name: 'Inicio', href: '/' },
  { name: 'Testing', href: '/testing' },
  { name: 'I+D', href: '/id' },
  { name: 'Formación', href: '/formacion' },
  { name: 'Talento', href: '/talento' },
  { name: 'Psicología', href: '/psicologia' }
]
---

<header class="w-full sticky top-0 z-50 bg-crema-calido/80 backdrop-blur-md border-b border-verde-bosque/10 transition-all duration-300">
  <nav class="flex justify-between items-center px-4 md:px-16 py-4 max-w-7xl mx-auto relative">
    <!-- Brand / Logo -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none">
      <Image
        src={logoImage}
        alt="Logo Matices"
        class="h-9 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
      />
    </a>

    <!-- Hamburger Button (Mobile Only) -->
    <button 
      id="menu-toggle-btn" 
      class="cursor-pointer md:hidden flex flex-col justify-between w-6 h-4.5 z-40 focus:outline-none" 
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span class="w-full h-0.5 bg-verde-bosque rounded transition-all duration-300"></span>
      <span class="w-full h-0.5 bg-verde-bosque rounded transition-all duration-300"></span>
      <span class="w-full h-0.5 bg-verde-bosque rounded transition-all duration-300"></span>
    </button>

    <!-- NAVEGACIÓN EXCLUSIVA DE ESCRITORIO (Desktop) -->
    <div class="hidden md:flex items-center gap-8">
      {navItems.map((item) => {
        const isActive = activePath === item.href;
        return (
          <a
            href={item.href}
            class={`font-sans text-base transition-colors relative py-1 hover:text-verde-bosque ${
              isActive 
                ? "text-verde-bosque font-semibold border-b-2 border-verde-bosque" 
                : "text-verde-bosque/80 hover:text-verde-bosque"
            }`}
          >
            {item.name}
          </a>
        );
      })}
      
      <!-- CTA Button de Escritorio -->
      <a 
        href="/contacto" 
        class="bg-verde-bosque text-white px-6 py-2.5 rounded-full font-sans font-semibold hover:opacity-90 active:scale-95 transition-all text-center"
      >
        Solicitar Asesoría
      </a>
    </div>
  </nav>

  <!-- NAVEGACIÓN EXCLUSIVA MÓVIL (Mobile Drawer) -->
  <!-- Estos elementos serán movidos automáticamente al <body> por el script cliente para evitar containing blocks -->
  
  <!-- Overlay del Drawer -->
  <div 
    id="drawer-overlay" 
    class="fixed inset-0 bg-black/20 backdrop-blur-xs z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"
    data-portal="true"
  ></div>

  <!-- Panel del Drawer -->
  <div 
    id="drawer-panel" 
    class="fixed top-0 right-0 h-dvh w-[80vw] max-w-100 bg-crema-calido border-l border-verde-bosque/10 shadow-2xl flex flex-col justify-between px-6 py-16 z-50 transform translate-x-full invisible transition-all duration-300 ease-in-out md:hidden"
    data-portal="true"
  >
    <div>
      <!-- Botón de Cierre Dedicado (Móvil) -->
      <button 
        id="drawer-close-btn" 
        class="absolute top-4 right-4 text-verde-bosque hover:opacity-80 p-2 focus:outline-none"
        aria-label="Cerrar menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Navigation Links Móviles -->
      <div class="flex flex-col gap-6 mt-8">
        {navItems.map((item) => {
          const isActive = activePath === item.href;
          return (
            <a
              href={item.href}
              class={`font-sans text-lg transition-colors relative py-3 hover:text-verde-bosque w-full text-left border-b border-verde-bosque/5 block ${
                isActive 
                  ? "text-verde-bosque font-semibold border-b-2 border-verde-bosque/20" 
                  : "text-verde-bosque/80 hover:text-verde-bosque"
              }`}
            >
              {item.name}
            </a>
          );
        })}
      </div>
    </div>
    
    <!-- Sticky CTA Button Móvil posicionado elegantemente abajo -->
    <div class="w-full mt-auto">
      <a 
        href="/contacto" 
        class="bg-verde-bosque text-white px-6 py-3 rounded-full font-sans font-semibold hover:opacity-90 active:scale-95 transition-all text-center block w-full"
      >
        Solicitar Asesoría
      </a>
    </div>
  </div>
</header>

<script>
  // Inicialización diferida para asegurar carga completa
  function initDrawer() {
    const toggleBtn = document.getElementById('menu-toggle-btn');
    const closeBtn = document.getElementById('drawer-close-btn');
    const panel = document.getElementById('drawer-panel');
    const overlay = document.getElementById('drawer-overlay');
    const body = document.body;

    if (!toggleBtn || !panel || !overlay || !closeBtn) return;

    // PORTAL PATTERN: Mover overlay y panel fuera de la cabecera directamente al body
    // Esto previene que hereden el stacking context y backdrop-filter del header sticky
    if (panel.parentNode !== body) {
      body.appendChild(overlay);
      body.appendChild(panel);
    }

    // Elementos a desenfocar cuando el menú esté abierto
    // Desenfocamos el header (para desenfocar el logo) y el contenedor principal main/footer
    const header = document.querySelector('header');
    const main = document.querySelector('main');
    const footer = document.querySelector('footer');
    const backgroundElements = [header, main, footer].filter(Boolean) as HTMLElement[];

    // Configurar transición para el efecto de desenfoque suave
    backgroundElements.forEach(el => {
      if (el) {
        el.style.transition = 'filter 0.3s ease-in-out, -webkit-filter 0.3s ease-in-out';
      }
    });

    function openMenu() {
      if (panel && overlay && toggleBtn && body) {
        panel.classList.remove('translate-x-full', 'invisible');
        panel.classList.add('translate-x-0', 'visible');

        overlay.classList.remove('opacity-0', 'pointer-events-none');
        overlay.classList.add('opacity-100', 'pointer-events-auto');

        body.classList.add('overflow-hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');

        // Aplicar efecto blur al resto del sitio (incluye cabecera/logo y contenido)
        backgroundElements.forEach(el => {
          if (el) {
            el.style.filter = 'blur(6px)';
            el.style.webkitFilter = 'blur(6px)';
          }
        });
      }
    }

    function closeMenu() {
      if (panel && overlay && toggleBtn && body) {
        panel.classList.add('translate-x-full', 'invisible');
        panel.classList.remove('translate-x-0', 'visible');

        overlay.classList.add('opacity-0', 'pointer-events-none');
        overlay.classList.remove('opacity-100', 'pointer-events-auto');

        body.classList.remove('overflow-hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');

        // Remover el efecto blur de fondo con transición suave
        backgroundElements.forEach(el => {
          if (el) {
            el.style.filter = '';
            el.style.webkitFilter = '';
          }
        });
      }
    }

    toggleBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    overlay.addEventListener('click', closeMenu);

    // Salvaguarda para cuando se redimensiona a escritorio para restaurar scroll y blur
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });
  }

  // Ejecutar en la carga inicial y soporte para transiciones de Astro (si se añadieran)
  initDrawer();
  document.addEventListener('astro:page-load', initDrawer);
</script>
