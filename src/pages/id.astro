---
import Layout from '../layouts/Layout.astro'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import CompanyLogos from '../components/global/CompanyLogos.astro'
import Reveal from '../components/ui/Reveal.astro'
import { Image } from 'astro:assets'
import EvidenceGallery from '../components/ui/EvidenceGallery.astro'

// Optimized image imports
import portadaId from '../assets/portada-id.jpg'
import scouthemImg from '../assets/scouthem.jpg'

interface IdMilestone {
  number: string
  title: string
  description: string
}

const idMilestones: IdMilestone[] = [
  {
    number: '1',
    title: 'IA Predictiva',
    description:
      'Algoritmos avanzados con enfoque ético diseñados para predecir y optimizar la complementariedad cultural de los perfiles en el ecosistema corporativo.',
  },
  {
    number: '2',
    title: 'Monitoreo de Bienestar',
    description:
      'Modelos analíticos orientados a la detección temprana de indicadores de estrés psicosocial y optimización del clima laboral.',
  },
  {
    number: '3',
    title: 'Rigurosidad Científica',
    description:
      'Validación empírica y metodológica constante en conjunto con centros académicos nacionales e internacionales, garantizando herramientas robustas.',
  },
]
---

<Layout
  title="Investigación y Desarrollo (I+D)"
  description="Matices Consultoría - Innovación, metodologías científicas de vanguardia y desarrollo continuo en psicología organizacional para el ecosistema corporativo."
>
  <Header activePath="/id" />

  <main class="w-full">
    <!-- Hero Section -->
    <section
      class="relative w-full overflow-hidden pt-12 pb-24 md:pt-20 md:pb-32 bg-radial from-verde-lima/5 to-transparent"
    >
      <div class="absolute -top-10 -right-10 h-48 w-48 rounded-full bg-verde-lima/10 blur-3xl -z-10 pointer-events-none animate-float"></div>
      <div
        class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
      >
        <!-- Hero Copy -->
        <div class="lg:col-span-7 space-y-6 z-10 text-left">
          <Reveal as="span" variant="fade-up" delay={0} class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Innovación Científica &amp; Futuro
          </Reveal>
          <Reveal as="h1" variant="fade-up" delay={80} class="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-verde-bosque leading-tight">
            Investigación y <span class="text-verde-lima font-normal italic"
              >Desarrollo (I+D)</span
            >
          </Reveal>
          <Reveal as="p" variant="fade-up" delay={160} class="font-sans text-lg text-verde-bosque/80 max-w-xl leading-relaxed">
            Diseñamos metodologías y herramientas innovadoras en psicología
            organizacional, impulsando la evolución constante del capital humano
            y la resiliencia en el ecosistema corporativo.
          </Reveal>
          <Reveal as="div" variant="fade-up" delay={240} class="flex flex-col sm:flex-row gap-4 pt-2">
            <a
              target="_blank"
              href="https://www.instagram.com/reels/DTii2C7AUeq/"
              class="bg-verde-bosque text-white font-sans text-center font-semibold py-4 px-8 rounded-xl hover:opacity-90 active:scale-95 transition-all text-sm block"
            >
              Conoce la Investigación
            </a>
          </Reveal>
        </div>

        <!-- Graphic Content -->
        <Reveal as="div" variant="scale-in" delay={120} class="lg:col-span-5 relative w-full flex justify-center">
          <div
            class="w-full max-w-md aspect-[4/5] rounded-[3rem] overflow-hidden shadow-2xl relative border-4 border-white/40"
          >
            <Image
              src={portadaId}
              alt="Líderes de Matices analizando métricas de investigación B2B"
              width={640}
              height={800}
              format="avif"
              loading="eager"
              sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 640px"
              class="w-full h-full object-cover"
            />
          </div>
          <Reveal as="div" variant="fade-up" delay={320} class="absolute -bottom-6 -right-6 bg-white/70 backdrop-blur-md p-6 rounded-2xl shadow-xl border border-verde-bosque/10 max-w-[200px] hidden sm:block">
            <p class="font-heading text-xl font-bold text-verde-bosque mb-1">
              I+D
            </p>
            <p class="text-sm font-semibold text-verde-bosque/70 leading-tight">
              Diseño de metodologías de vanguardia.
            </p>
          </Reveal>
        </Reveal>
      </div>
    </section>

    <!-- Sección Central: Investigación e Innovación Aplicada -->
    <section class="w-full py-20 bg-white">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 text-center space-y-8">
        <Reveal as="div" variant="fade-up" class="space-y-4 max-w-3xl mx-auto">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-bosque/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Psicología Aplicada al Ecosistema Corporativo
          </span>
          <h2 class="font-heading text-3xl md:text-5xl font-bold text-verde-bosque leading-tight">
            Décadas de Trayectoria e <span class="text-verde-lima font-normal italic">Innovación Internacional</span>
          </h2>
          <p class="font-sans text-base md:text-lg text-verde-bosque/75 leading-relaxed">
            Nuestra consultora reúne la experiencia acumulada en el diseño e implementación de metodologías científicas para el diagnóstico organizacional, el desarrollo de liderazgos y la optimización de procesos de capital humano a nivel global, uniendo la academia y el ecosistema empresarial.
          </p>
        </Reveal>
      </div>
    </section>

    <!-- Sección: Proyecto FONDEF -->
    <section class="w-full py-20 bg-crema-calido/30 border-y border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Encabezado del bloque -->
        <Reveal as="div" variant="fade-up" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
              Validación Científica &amp; Innovación
            </span>
            <h3 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque">
              Proyecto FONDEF IDEA I+D 2025–2026
            </h3>
            <p class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed max-w-3xl">
              Desarrollamos soluciones respaldadas por la academia. Junto a la Pontificia Universidad Católica de Valparaíso, impulsamos un proyecto de I+D financiado por FONDEF de ANID. La plataforma ALCORA TECH, una solución pensada en profesionales  que integra inteligencia artificial y conocimiento científico para crear herramientas innovadoras de evaluación diagnóstica, fortaleciendo la calidad y precisión de nuestros servicios.
            </p>
          </div>
          <div class="lg:col-span-4 flex lg:justify-end">
            <div class="bg-white/70 backdrop-blur-md p-6 rounded-2xl border border-verde-bosque/10 max-w-[280px] shadow-sm">
              <div class="text-xl font-bold text-verde-bosque mb-2">ANID / FONDEF</div>
              <p class="text-xs text-verde-bosque/70 leading-relaxed font-sans">
                Proyecto de Investigación y Desarrollo de frontera tecnológica, enfocado en resolver las brechas críticas de fidelización y bienestar laboral.
              </p>
            </div>
          </div>
        </Reveal>

        <!-- Hitos Tecnológicos (Legibilidad & Grilla) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-4">
          {idMilestones.map((milestone, i) => (
            <Reveal as="article" variant="fade-up" delay={i * 80} class="bg-white p-8 rounded-2xl hover:shadow-md transition-shadow border border-verde-bosque/5 space-y-4 text-left">
              <div class="w-10 h-10 rounded-full bg-verde-lima/10 flex items-center justify-center text-verde-bosque font-bold font-sans text-sm">
                {milestone.number}
              </div>
              <h4 class="font-heading text-xl font-bold text-verde-bosque">{milestone.title}</h4>
              <p class="font-sans text-sm text-verde-bosque/75 leading-relaxed">
                {milestone.description}
              </p>
            </Reveal>
          ))}
        </div>

      </div>
    </section>

    <!-- Sección: Cierre y Scouthem -->
    <section class="w-full py-24 bg-white">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Columna de Texto: Priorizada arriba en móviles con order-1, a la derecha en escritorio con lg:order-2 -->
        <Reveal as="div" variant="fade-up" class="order-1 lg:order-2 space-y-6 text-left">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-bosque/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Plataforma de Talento Inteligente
          </span>
          <h3 class="font-heading text-3xl md:text-5xl font-bold text-verde-bosque leading-tight">
            I+D en <span class="text-verde-lima font-normal italic">Scouthem</span>
          </h3>
          <p class="font-sans text-base md:text-lg text-verde-bosque/75 leading-relaxed">
            La solución tecnológica para la gestión del talento. Diseñada en base a las necesidades organizacionales y metodologías de investigación científica validadas bajo el respaldo europeo. Scouthem automatiza el reclutamiento integrando la inteligencia artificial y psicometría avanzada para procesos de evaluación y predicción del desempeño organizacional. Una plataforma robusta, ágil e intuitiva.
          </p>
           
          <div class="pt-4">
            <a 
              href="https://scouthem.com/es/pagina-de-inicio/" 
              target="_blank" 
              class="inline-block bg-verde-bosque text-white font-sans text-center font-semibold py-4 px-10 rounded-xl hover:opacity-90 active:scale-95 transition-all text-sm shadow-md hover:shadow-lg"
            >
              CONOCER SCOUTHEM
            </a>
          </div>
        </Reveal>

        <!-- Columna de Video: Abajo en móviles con order-2, a la izquierda en escritorio con lg:order-1 -->
        <Reveal as="div" variant="scale-in" delay={120} class="order-2 lg:order-1 relative w-full flex justify-center">
          <a 
            href="https://www.instagram.com/reels/C58Wc2oOf9U/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group block w-full aspect-video rounded-3xl overflow-hidden shadow-2xl border-4 border-crema-calido relative"
          >
            <!-- Imagen -->
            <Image 
              src={scouthemImg} 
              alt="Demostración interactiva del software Scouthem" 
              width={640}
              height={360}
              format="avif"
              loading="lazy"
              sizes="(max-width: 768px) 100vw, 50vw"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            
            <!-- Capa Overlay en Hover -->
            <div class="absolute inset-0 bg-verde-bosque/60 backdrop-blur-sm opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col items-center justify-center gap-3">
              <!-- Icono de Play estilizado -->
              <div class="w-16 h-16 rounded-full bg-verde-lima text-verde-bosque flex items-center justify-center shadow-lg transform scale-90 group-hover:scale-100 transition-all duration-300">
                <svg class="w-8 h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <!-- Texto -->
              <span class="font-sans font-bold text-crema-calido text-lg tracking-wider">
                Ver video
              </span>
            </div>
          </a>
        </Reveal>

      </div>
    </section>

    <!-- Sección: Prueba Social / Clientes (Componente Reutilizable) -->
    <CompanyLogos />

    <!-- Sección: Galería de Evidencias estilo Masonry -->
    <section class="w-full py-24 bg-crema-calido/20 border-t border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-12">
        <Reveal as="div" variant="fade-up" class="text-center space-y-3">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-bosque/5 text-verde-bosque/80 font-sans text-xs font-semibold tracking-wider uppercase">
            Galería de actividades
          </span>
          <h3 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque">
            Nuestra Práctica en Acción
          </h3>
          <p class="font-sans text-sm text-verde-bosque/60 max-w-2xl mx-auto">
            Registro visual del trabajo al servicio de las personas y organizaciones. Talleres de supervisión y actividades de investigación aplicada lideradas por nuestro equipo.
          </p>
        </Reveal>

        <EvidenceGallery />
      </div>
    </section>
  </main>

  <Footer />
</Layout>
