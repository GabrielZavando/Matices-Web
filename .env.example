# web3forms access key for the static contact form (serverless).
# Copy this file to .env and set your real key. .env is gitignored.
PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

# OmniRoute API key for the OpenCode provider. opencode.json resolves it via
# {env:OMNIROUTE_API_KEY} (FW-ENV); never commit the literal key.
OMNIROUTE_API_KEY=your-omniroute-api-key
