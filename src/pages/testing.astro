---
import Layout from '../layouts/Layout.astro'
import Header from '../components/global/Header.astro'
import Footer from '../components/global/Footer.astro'
import CompanyLogos from '../components/global/CompanyLogos.astro'
import Reveal from '../components/ui/Reveal.astro'
import EvidenceGallery from '../components/ui/EvidenceGallery.astro'
import ScouthemShowcase from '../components/ui/ScouthemShowcase.astro'

interface TestType {
  title: string
  icon: string
  description: string
}

const testTypes: TestType[] = [
  {
    title: 'Habilidades Cognitivas',
    icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
    description:
      'Evaluaciones enfocadas en medir las aptitudes cognitivas, razonamiento lógico, agilidad numérica y habilidades verbales de postulantes, asegurando el nivel de resolución requerido para cada puesto.',
  },
  {
    title: 'Personalidad',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
    description:
      'Análisis de perfiles conductuales, estilos de comunicación, manejo de la frustración e inteligencia emocional, garantizando un encaje óptimo con la cultura organizacional y el liderazgo corporativo.',
  },
  {
    title: 'Neuropsicológicos',
    icon: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
    description:
      'Pruebas clínicas y laborales orientadas a evaluar funciones ejecutivas avanzadas, velocidad de procesamiento, concentración sostenida y toma de decisiones complejas bajo escenarios de alta presión corporativa.',
  },
  {
    title: 'Evaluación científica con soporte de IA',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
    description:
      'Evaluaciones online, analizadas e interpretadas con soporte algorítmico avanzado, normas nacionales e internacionales, que aportan confiabilidad y rigor científico a la hora de descubrir patrones profundos y proporcionar un reporte holístico automatizado.',
  },
  {
    title: 'Encuestas a tu medida',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
    description:
      'Diseñamos encuestas personalizadas para procesos de evaluación de desempeño, clima organizacional, salud ocupacional y otros diagnósticos estratégicos. A través de nuestra plataforma Scouthem, garantizamos la aplicación de encuestas con altos estándares de confidencialidad y anonimato, facilitando la obtención de información confiable para la toma de decisiones. Nuestros informes instantáneos incorporan inteligencia artificial para identificar tendencias, generar análisis de valor y fortalecer decisiones basadas en evidencia.',
  },
]

interface TestApplication {
  title: string
  description: string
}

const testApplications: TestApplication[] = [
  {
    title: 'Procesos de Reclutamiento y Selección',
    description:
      'Filtros iniciales y avanzados para predecir con alta certeza el desempeño de candidatos(as) y su adaptación al puesto.',
  },
  {
    title: 'Planes de Sucesión y Promoción Interna',
    description:
      'Identificación objetiva del potencial de liderazgo dentro de tu organización para ascensos internos seguros.',
  },
  {
    title: 'Desarrollo de Equipos de Alto Rendimiento',
    description:
      'Diagnósticos grupales para entender la sinergia, complementariedad de roles y brechas conductuales en el equipo.',
  },
  {
    title: 'Detección de Necesidades de Capacitación (DNC)',
    description:
      'Mapeo de habilidades técnicas y blandas para el diseño de planes de formación y desarrollo a la medida.',
  },
]
---

<Layout
  title="Testing y Diagnóstico"
  description="Matices Consultoría - Herramientas rigurosas de testing, pruebas psicométricas y diagnóstico organizacional para potenciar el talento B2B."
>
  <Header activePath="/testing" />

  <main class="w-full">
    <!-- Page heading (visually hidden): keeps a single h1 after the hero removal -->
    <h1 class="sr-only">Pruebas y Testing Organizacional</h1>

    <!-- Section: Scouthem platform showcase (TICKET-007) -->
    <ScouthemShowcase />

    <!-- Section: Evaluación Psicométrica y Tipos de Test -->
    <section class="w-full py-20 bg-white/40 border-t border-verde-bosque/5">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-16">
        
        <!-- Cabecera Informativa -->
        <Reveal as="div" variant="fade-up" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
          <div class="lg:col-span-5 space-y-4">
            <span class="inline-block px-4 py-1.5 rounded-full bg-azul-celeste/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
              Evaluación Psicométrica Profesional
            </span>
            <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque leading-tight">
              Psicometría Científica de Vanguardia Potenciada por <span class="text-verde-lima font-normal italic">Inteligencia Artificial</span>
            </h2>
          </div>
          <div class="lg:col-span-7 lg:pt-8">
            <p class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed">
              En Matices combinamos metodologías psicológicas tradicionales de validez comprobada, con herramientas modernas de análisis de datos e Inteligencia Artificial. Esto nos permite estructurar perfiles profesionales ultra precisos, reduciendo el margen de error en la selección de cargos críticos y el desarrollo de equipos.
            </p>
            <div class="mt-6 flex justify-end">
              <a
                href="https://www.instagram.com/reels/DSS9ZHugYvJ/"
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center justify-center gap-2 bg-verde-bosque text-white hover:bg-verde-bosque/95 font-sans font-semibold py-3.5 px-8 rounded-xl transition-all duration-300 hover:shadow-md active:scale-[0.98] w-full sm:w-auto text-sm"
              >
                <span>Conoce Scouthem</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </Reveal>

        <!-- Grid de los Tipos de Test -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {testTypes.map((test, i) => (
            <Reveal as="article" variant="fade-up" delay={i * 80} class="bg-crema-calido p-8 rounded-[2rem] flex flex-col justify-between hover:shadow-lg transition-shadow border border-verde-bosque/5 group min-h-[260px]">
              <div class="space-y-4">
                <div class="w-12 h-12 rounded-xl bg-verde-bosque/5 flex items-center justify-center text-verde-bosque group-hover:scale-105 transition-transform duration-300">
                  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={test.icon} />
                  </svg>
                </div>
                <h3 class="font-heading text-2xl font-bold text-verde-bosque">{test.title}</h3>
                <p class="font-sans text-sm text-verde-bosque/75">
                  {test.description}
                </p>
              </div>
            </Reveal>
          ))}
        </div>
      </div>
    </section>

    <!-- Section: Aplicaciones del Testing -->
    <section class="w-full py-20 bg-crema-calido/30">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- Columna Izquierda: Rigor Científico -->
        <Reveal as="div" variant="fade-up" class="space-y-6 text-left">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Metodología e Innovación
          </span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque">
            Rigor Científico y Tecnología Avanzada
          </h2>
          <p class="font-sans text-base md:text-lg text-verde-bosque/80 leading-relaxed">
            Cada test seleccionado responde a estrictos estándares de validez y confiabilidad estadística. Estudiamos las bases conductuales de la psicología organizacional moderna y las potenciamos con algoritmos avanzados para mitigar sesgos cognitivos en los procesos de selección e identificación del potencial humano.
          </p>
        </Reveal>

        <!-- Columna Derecha: Aplicaciones del Testing (Viñetas de verificación) -->
        <Reveal as="div" variant="fade-up" delay={160} class="bg-white p-8 md:p-12 rounded-[2.5rem] shadow-xl border border-verde-bosque/5 space-y-8">
          <h3 class="font-heading text-2xl font-bold text-verde-bosque">
            Aplicaciones del Testing Organizacional
          </h3>
          <ul class="space-y-6">
            {testApplications.map((app) => (
              <li class="flex items-start gap-4 group">
                <span class="w-8 h-8 rounded-full bg-verde-lima/10 flex items-center justify-center flex-shrink-0 mt-0.5 group-hover:scale-110 transition-transform duration-300">
                  <svg class="h-5 w-5 text-verde-lima" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <div>
                  <h4 class="font-sans font-bold text-verde-bosque text-base mb-1">
                    {app.title}
                  </h4>
                  <p class="font-sans text-sm text-verde-bosque/70 leading-relaxed">
                    {app.description}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </Reveal>

      </div>
    </section>

    <!-- Section: Prueba Social / Clientes -->
    <CompanyLogos />

    <!-- Section: Galería de Evidencia -->
    <section class="w-full py-20 bg-crema-calido/20">
      <div class="max-w-[1280px] mx-auto px-4 md:px-16 space-y-12">
        <Reveal as="div" variant="fade-up" class="text-center space-y-3">
          <span class="inline-block px-4 py-1.5 rounded-full bg-verde-lima/10 text-verde-bosque font-sans text-xs font-semibold tracking-wider uppercase">
            Actividad &amp; Ejecución Práctica
          </span>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-verde-bosque">
            Galería
          </h2>
          <p class="font-sans text-base text-verde-bosque/75">
            Registros reales de la ejecución práctica de nuestras evaluaciones, herramientas tecnológicas y talleres integrativos.
          </p>
        </Reveal>

        <EvidenceGallery />
      </div>
    </section>

    <!-- Banner de Dolor / Empatía & Conversión Contextual -->
    <section class="w-full py-20 bg-[#2e3131] text-crema-calido relative overflow-hidden shadow-xl">
      <div class="absolute top-0 right-0 w-64 h-64 bg-verde-lima/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-azul-celeste/5 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>
      
      <Reveal as="div" variant="fade-up" class="max-w-[1280px] mx-auto px-4 md:px-16 relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-6">
          <span class="inline-block px-4 py-1 rounded-full bg-white/10 text-crema-calido font-sans text-xs font-semibold uppercase tracking-widest">
            Alianza Estratégica B2B
          </span>
          <h2 class="font-heading text-3xl md:text-5xl font-bold leading-tight">
            ¿Listo para transformar tu ecosistema laboral?
          </h2>
          <p class="font-sans text-base md:text-lg text-crema-calido/80 max-w-3xl leading-relaxed">
            Consigue el perfil idóneo y el encaje cultural óptimo para tu empresa con evaluaciones psicométricas de alta fidelidad técnica e interpretación asistida por IA. Hablemos y diseñemos un plan a tu medida.
          </p>
        </div>
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-4 justify-start lg:justify-end w-full">
          <a 
            href="/contacto" 
            class="bg-verde-lima hover:bg-verde-lima/90 text-verde-bosque font-sans font-bold py-4 px-10 rounded-full hover:scale-105 transition-all shadow-lg text-center w-full block"
          >
            AGENDAR CONSULTORÍA
          </a>
        </div>
      </Reveal>
    </section>
  </main>

  <Footer />
</Layout>
