# .npmrc — registry configuration for private GitHub Packages
#
# El paquete @gabrielzavando/specboot se publica en GitHub Package Registry
# (no en el npm público). Este archivo redirige el scope @gabrielzavando al
# registry de GitHub Packages y desactiva el sandboxing de pnpm para
# permitir builds en scripts de CI.
#
# Autenticación en CI: el workflow debe inyectar NODE_AUTH_TOKEN
# (típicamente con ${{ secrets.GITHUB_TOKEN }}, que tiene permisos de
# lectura sobre packages del mismo repo).
#
# Locally: export NODE_AUTH_TOKEN=<personal-access-token-with-read:packages>
# o usa `gh auth token` si tienes `gh` autenticado.

@gabrielzavando:registry=https://npm.pkg.github.com
engine-strict=false
auto-install-peers=true
strict-peer-dependencies=false
